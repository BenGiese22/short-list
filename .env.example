# Turso (libSQL) mirror the viewer reads from. Use the READ-ONLY token here --
# publish.py (in home-search) uses a separate read-write token to sync data.
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# Passcode required to view the site, and the secret used to sign the
# session cookie issued after a correct passcode. Keep COOKIE_SECRET random
# and private; anyone with it can forge a valid session.
SITE_PASSCODE=
COOKIE_SECRET=

# Shared secret publish.py sends to /api/revalidate after a sync, so the
# viewer picks up fresh data without waiting for cache expiry.
REVALIDATE_SECRET=
