# Development environment values for the containerised viewer.
#
# THIS FILE IS COMMITTED ON PURPOSE. Every value in it is throwaway and only
# ever reaches a container on your own machine. Nothing here is a secret, and
# nothing here is used by any deployed environment.
#
# The filename has no leading dot deliberately: .gitignore carries `.env*` with
# a single `!.env.example` exemption, so a file named `.env.dev` would be
# silently untracked and every clean checkout would fail to boot.

# The passcode the gate asks for. Type this at /enter.
SITE_PASSCODE=1234

# Signs the session cookie. Fixed rather than random so restarting the
# container does not log you out mid-review.
COOKIE_SECRET=dev-only-cookie-secret-not-used-anywhere-real

# `npm run dev:seed` sends this to /api/revalidate after reseeding, so Next
# drops the 'use cache' entries behind getListings/getListing.
REVALIDATE_SECRET=dev-only-revalidate-secret

# A local SQLite file rather than a Turso database. @libsql/client accepts a
# file: URL and ignores the auth token when it sees one, which is why none of
# the application code needs a development branch.
TURSO_DATABASE_URL=file:/data/dev.db
TURSO_AUTH_TOKEN=unused-for-file-urls

# realistic | edge-cases | empty | huge
SEED_PROFILE=realistic

# Read by the expiring-share-links work (PR #7) and harmless before it merges.
SHARE_KEY_VERSION=1

# Serve public/dev-photos originals instead of running them through the image
# optimizer. Required locally: the optimizer's internal fetch carries no
# session cookie and proxy.ts gates /dev-photos, so optimization fails with
# "The requested resource isn't a valid image." See next.config.ts.
DEV_UNOPTIMIZED_IMAGES=1
